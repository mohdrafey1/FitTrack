# FitTrack backend configuration.
# Copy to .env and fill in. Never commit .env — it is gitignored.

# --- Core ---------------------------------------------------------------

# MongoDB connection string. Defaults to a local instance if unset.
MONGODB_URI=mongodb://localhost:27017/fittrack

# Signing secret for the JWTs handed to clients.
# REQUIRED in production — the built-in fallback is a known placeholder.
JWT_SECRET=

# Port the server listens on. Defaults to 6001, which is what the mobile app
# probes during development.
PORT=6001

# --- AI nutrition lookup ------------------------------------------------

# Google AI Studio API key, used by POST /api/custom-foods/ai-suggest to fill
# in macros from a food name. Get one at https://aistudio.google.com/apikey
#
# Optional: with no key the route answers 503 and the mobile app hides its
# "Fill with AI" button. Everything else keeps working.
#
# This key must stay server-side. Do not move it into the Expo app — anything
# prefixed EXPO_PUBLIC_ is inlined into the JS bundle and can be read out of a
# shipped APK or IPA.
GEMINI_API_KEY=

# Optional model override. Defaults to gemini-3.1-flash-lite, the cheapest
# model that handles this task well.
GEMINI_MODEL=
